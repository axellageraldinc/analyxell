<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Analyxell.Pages.ComparePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Analyxell.Controls"
    xmlns:svc="using:Analyxell.Services"
    xmlns:vm="using:Analyxell.ViewModels"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel Padding="32,8,32,32" Spacing="16" MaxWidth="1240" HorizontalAlignment="Stretch">
            <StackPanel Spacing="2">
                <TextBlock Text="Compare two runs" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Text="Use it to check whether a change helped, for example turning a setting off. Pick the earlier run as A and the later run as B." />
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="8">
                    <ComboBox
                        AutomationProperties.AutomationId="BaselineCombo"
                        Header="A: baseline"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Loaded, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.A, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        PlaceholderText="Choose a loaded capture" />
                    <Button Content="Load a capture as A..." Command="{x:Bind ViewModel.LoadACommand, Mode=OneTime}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="8">
                    <ComboBox
                        AutomationProperties.AutomationId="LaterCombo"
                        Header="B: later run"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{x:Bind ViewModel.Loaded, Mode=OneTime}"
                        SelectedItem="{x:Bind ViewModel.B, Mode=TwoWay}"
                        DisplayMemberPath="Name"
                        PlaceholderText="Choose a loaded capture" />
                    <Button Content="Load a capture as B..." Command="{x:Bind ViewModel.LoadBCommand, Mode=OneTime}" />
                </StackPanel>
            </Grid>

            <InfoBar
                Severity="Error"
                Title="Could not open the capture"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                Severity="Informational"
                IsOpen="True"
                IsClosable="False"
                Title="{x:Bind ViewModel.Summary, Mode=OneWay}" />

            <InfoBar
                AutomationProperties.AutomationId="CompareChanges"
                Severity="{x:Bind ViewModel.ChangesSeverity, Mode=OneWay}"
                Title="{x:Bind ViewModel.ChangesTitle, Mode=OneWay}"
                Message="{x:Bind ViewModel.ChangesNote, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasChangesNote, Mode=OneWay}"
                IsClosable="False" />

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasRows, Mode=OneWay}">
                <Border
                    Padding="16,12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="4">
                        <Grid ColumnSpacing="12" Padding="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="1.4*" />
                                <ColumnDefinition Width="Auto" MinWidth="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Measure" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="A" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="B" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="3" Text="Change" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="4" Text="Result" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <ItemsControl ItemsSource="{x:Bind ViewModel.Rows, Mode=OneTime}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CompareRowItem">
                                    <Grid ColumnSpacing="12" Padding="0,6" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="Auto" MinWidth="90" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind A, Mode=OneTime}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind B, Mode=OneTime}" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Delta, Mode=OneTime}" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind Verdict, Mode=OneTime}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16,12,16,8"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ChartCaption, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox
                                Grid.Column="1"
                                AutomationProperties.AutomationId="CompareViewCombo"
                                ItemsSource="{x:Bind ViewModel.ChartViews, Mode=OneWay}"
                                SelectedItem="{x:Bind ViewModel.SelectedChartView, Mode=TwoWay}"
                                DisplayMemberPath="Label"
                                MinWidth="200"
                                VerticalAlignment="Top" />
                        </Grid>
                        <controls:FrameTimeChart x:Name="Chart" Height="280" />
                    </StackPanel>
                </Border>

                <controls:AiPanel ViewModel="{x:Bind ViewModel.Ai, Mode=OneTime}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
