<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Analyxell.Pages.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Analyxell.Controls"
    xmlns:core="using:Analyxell.Core.Mcp"
    xmlns:vm="using:Analyxell.ViewModels"
    NavigationCacheMode="Required"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Page.Resources>
        <DataTemplate x:Key="NextStepTemplate" x:DataType="vm:NextStepItem">
            <Grid ColumnSpacing="12" Padding="0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="13" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Top">
                    <TextBlock Text="{x:Bind Number, Mode=OneTime}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{x:Bind Text, Mode=OneTime}" TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind Why, Mode=OneTime}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <HyperlinkButton
                        Content="I'll try this and check if it helped"
                        Padding="0"
                        Tag="{x:Bind Text, Mode=OneTime}"
                        Visibility="{x:Bind CanTry, Mode=OneTime}"
                        Click="TryStep_Click" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FindingTemplate" x:DataType="vm:FindingItem">
            <InfoBar
                Margin="0,0,0,8"
                IsOpen="True"
                IsClosable="False"
                Severity="{x:Bind Severity, Mode=OneTime}"
                Title="{x:Bind Title, Mode=OneTime}">
                <StackPanel Spacing="6" Margin="0,0,0,8">
                    <TextBlock Text="{x:Bind Detail, Mode=OneTime}" TextWrapping="Wrap" />
                    <StackPanel Spacing="2" Visibility="{x:Bind HasSuggestions, Mode=OneTime}">
                        <TextBlock Text="What you can try" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Suggestions, Mode=OneTime}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind Evidence, Mode=OneTime}"
                        TextWrapping="Wrap"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </InfoBar>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="32,8,32,32" Spacing="16" MaxWidth="1240" HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button AutomationProperties.AutomationId="OpenCaptureButton" Content="Open capture..." Command="{x:Bind ViewModel.OpenFileCommand, Mode=OneTime}" Style="{StaticResource AccentButtonStyle}" />
                    <DropDownButton x:Name="RecentButton" AutomationProperties.AutomationId="RecentCapturesButton" Content="Recent captures" Click="RecentButton_Click">
                        <DropDownButton.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Width="420" Spacing="8">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.CatalogStatus, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.Catalog, Mode=OneTime}"
                                        IsItemClickEnabled="True"
                                        SelectionMode="None"
                                        MaxHeight="360"
                                        ItemClick="Catalog_ItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="core:CaptureListing">
                                                <StackPanel Padding="0,4">
                                                    <TextBlock Text="{x:Bind FileName, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Text="{x:Bind RecordedAtText, Mode=OneTime}"
                                                        Style="{StaticResource CaptionTextBlockStyle}"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button
                        AutomationProperties.AutomationId="PcSetupHeaderButton"
                        Content="PC setup..."
                        Click="Setup_Click"
                        IsEnabled="{x:Bind ViewModel.HasCapture, Mode=OneWay}" />
                    <Button
                        AutomationProperties.AutomationId="CapFrameXHeaderButton"
                        Content="{x:Bind ViewModel.CapFrameX.HeaderButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.CapFrameX.OpenOrGetCommand, Mode=OneTime}" />
                    <Button
                        AutomationProperties.AutomationId="ExportReportButton"
                        Content="Export report..."
                        Command="{x:Bind ViewModel.ExportCommand, Mode=OneTime}"
                        IsEnabled="{x:Bind ViewModel.HasCapture, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <InfoBar
                Severity="Error"
                Title="Could not open the capture"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                IsClosable="False" />

            <!-- Empty state -->
            <Border
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                Padding="32"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center" MaxWidth="560">
                    <Image Source="ms-appx:///Assets/Logo.png" Width="96" Height="96" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock Text="Drop a CapFrameX capture here" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="analyxell reads capture files (.json) from CapFrameX, shows how your game ran, finds freezes, stutter and other problems, and tells you what to try. It only reads: nothing is changed on your PC." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button AutomationProperties.AutomationId="OpenCaptureButton2" Content="Open capture..." Command="{x:Bind ViewModel.OpenFileCommand, Mode=OneTime}" Style="{StaticResource AccentButtonStyle}" />
                        <Button AutomationProperties.AutomationId="OpenLatestButton" Content="Open my newest capture" Command="{x:Bind ViewModel.OpenLatestCommand, Mode=OneTime}" />
                        <Button AutomationProperties.AutomationId="TrySampleButton" Content="Try a sample" Command="{x:Bind ViewModel.TrySampleCommand, Mode=OneTime}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.EmptyStatus, Mode=OneWay}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <controls:CapFrameXCard ViewModel="{x:Bind ViewModel.CapFrameX, Mode=OneTime}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.HasCapture, Mode=OneWay}">

                <!-- The one-line answer, then the numbers behind it -->
                <InfoBar
                    AutomationProperties.AutomationId="VerdictBar"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="{x:Bind ViewModel.VerdictSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.VerdictHeadline, Mode=OneWay}"
                    Message="{x:Bind ViewModel.VerdictDetail, Mode=OneWay}">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="CopySummaryButton"
                            Content="Copy summary to share"
                            Command="{x:Bind ViewModel.CopySummaryCommand, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    AutomationProperties.AutomationId="QualityBar"
                    Visibility="{x:Bind ViewModel.HasQuality, Mode=OneWay}"
                    Severity="Warning"
                    Title="This capture may not show the whole picture"
                    Message="{x:Bind ViewModel.QualityText, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.HasQuality, Mode=OneWay}"
                    IsClosable="False" />

                <InfoBar
                    AutomationProperties.AutomationId="ExperimentBar"
                    Visibility="{x:Bind ViewModel.HasExperiment, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.ExperimentSeverity, Mode=OneWay}"
                    Title="{x:Bind ViewModel.ExperimentTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ExperimentText, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.HasExperiment, Mode=OneWay}"
                    IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button
                            AutomationProperties.AutomationId="CancelExperimentButton"
                            Content="Stop tracking this"
                            Visibility="{x:Bind ViewModel.ExperimentCanCancel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.CancelExperimentCommand, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar
                    AutomationProperties.AutomationId="NewerCaptureBar"
                    Visibility="{x:Bind ViewModel.HasNewerCapture, Mode=OneWay}"
                    Severity="Informational"
                    Title="A newer capture was recorded"
                    Message="{x:Bind ViewModel.NewerCaptureName, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.HasNewerCapture, Mode=OneWay}"
                    CloseButtonCommand="{x:Bind ViewModel.DismissNewerCommand, Mode=OneTime}">
                    <InfoBar.ActionButton>
                        <Button AutomationProperties.AutomationId="OpenNewerButton" Content="Open it" Command="{x:Bind ViewModel.OpenNewerCommand, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Cards, Mode=OneTime}">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="126" MinColumnSpacing="12" MinRowSpacing="12" ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:MetricItem">
                            <controls:MetricCard Title="{x:Bind Title, Mode=OneTime}" Value="{x:Bind Value, Mode=OneTime}" Caption="{x:Bind Caption, Mode=OneTime}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <SelectorBar x:Name="Tabs" AutomationProperties.AutomationId="AnalyzeTabs" SelectionChanged="Tabs_SelectionChanged">
                    <SelectorBarItem x:Name="TabOverview" AutomationProperties.AutomationId="TabOverview" Text="Overview" Tag="Overview" IsSelected="True" />
                    <SelectorBarItem x:Name="TabAi" AutomationProperties.AutomationId="TabAi" Text="Ask AI" Tag="Ai" />
                    <SelectorBarItem x:Name="TabFindings" AutomationProperties.AutomationId="TabFindings" Text="Findings" Tag="Findings" />
                    <SelectorBarItem x:Name="TabPc" AutomationProperties.AutomationId="TabPc" Text="PC and setup" Tag="Pc" />
                    <SelectorBarItem x:Name="TabBackground" AutomationProperties.AutomationId="TabBackground" Text="Background programs" Tag="Background" />
                </SelectorBar>

                <!-- Overview: chart and the first steps -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsOverviewTab, Mode=OneWay}">

                    <!-- Compact AI bar -->
                    <Border
                        Padding="20,14"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                AutomationProperties.AutomationId="AiBarStatus"
                                Text="{x:Bind ViewModel.Ai.BarStatus, Mode=OneWay}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button
                                    AutomationProperties.AutomationId="AskAiBarButton"
                                    Content="Ask AI"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Padding="20,6"
                                    Visibility="{x:Bind ViewModel.Ai.IsConfigured, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.Ai.NotBusy, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.AskAiAndShowCommand, Mode=OneTime}" />
                                <Button
                                    AutomationProperties.AutomationId="OpenAiTabButton"
                                    Content="Open Ask AI tab"
                                    Click="OpenAiTab_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Chart -->
                    <Border
                        Padding="16,12,16,8"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.ChartTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.ChartCaption, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    AutomationProperties.AutomationId="ChartViewCombo"
                                    ItemsSource="{x:Bind ViewModel.ChartViews, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedChartView, Mode=TwoWay}"
                                    DisplayMemberPath="Label"
                                    MinWidth="200"
                                    VerticalAlignment="Top" />
                            </Grid>
                            <controls:FrameTimeChart x:Name="Chart" Height="280" />
                            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasEventToggles, Mode=OneWay}">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.EventToggles, Mode=OneWay}" AutomationProperties.AutomationId="EventToggles">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="16" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EventToggle">
                                            <CheckBox
                                                Content="{x:Bind Text, Mode=OneTime}"
                                                IsChecked="{x:Bind IsOn, Mode=TwoWay}"
                                                AutomationProperties.AutomationId="{x:Bind Text, Mode=OneTime}"
                                                MinWidth="0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    AutomationProperties.AutomationId="EventExplanation"
                                    Text="{x:Bind ViewModel.EventExplanation, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- What to do -->
                    <Border
                        Visibility="{x:Bind ViewModel.HasTopSteps, Mode=OneWay}"
                        Padding="20,16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="What you can do" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="In order of importance. Try one at a time, record the same route again, and use Compare to see whether it helped." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopSteps, Mode=OneWay}" ItemTemplate="{StaticResource NextStepTemplate}" />
                            <Expander
                                AutomationProperties.AutomationId="MoreStepsExpander"
                                Header="{x:Bind ViewModel.MoreStepsHeader, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasMoreSteps, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.MoreSteps, Mode=OneWay}" ItemTemplate="{StaticResource NextStepTemplate}" />
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Ask AI: the full panel -->
                <controls:AiPanel
                    ViewModel="{x:Bind ViewModel.Ai, Mode=OneTime}"
                    Visibility="{x:Bind ViewModel.IsAiTab, Mode=OneWay}" />

                <!-- Findings: what needs attention, the rest folded away -->
                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.IsFindingsTab, Mode=OneWay}">
                    <TextBlock
                        Visibility="{x:Bind ViewModel.HasAttention, Mode=OneWay}"
                        Text="Needs attention"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.AttentionFindings, Mode=OneWay}" ItemTemplate="{StaticResource FindingTemplate}" />
                    <Expander
                        AutomationProperties.AutomationId="OtherNotesExpander"
                        Header="{x:Bind ViewModel.NotesHeader, Mode=OneWay}"
                        IsExpanded="{x:Bind ViewModel.NotesExpanded, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasNotes, Mode=OneWay}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.NoteFindings, Mode=OneWay}" ItemTemplate="{StaticResource FindingTemplate}" />
                    </Expander>
                </StackPanel>

                <!-- PC and setup -->
                <StackPanel Spacing="16" Visibility="{x:Bind ViewModel.IsPcTab, Mode=OneWay}">
                    <Border
                        Padding="20,16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="12" AutomationProperties.AutomationId="PcSpecs">
                            <TextBlock Text="This PC" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.SpecSummary, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.SpecSections, Mode=OneWay}">
                                <ItemsRepeater.Layout>
                                    <UniformGridLayout MinItemWidth="330" MinColumnSpacing="24" MinRowSpacing="16" ItemsStretch="Fill" />
                                </ItemsRepeater.Layout>
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SpecSectionView">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock Text="{x:Bind Lines, Mode=OneTime}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </StackPanel>
                    </Border>

                    <InfoBar
                        AutomationProperties.AutomationId="SettingsNote"
                        Severity="Warning"
                        Title="The game's settings file may not match this capture"
                        Message="{x:Bind ViewModel.SettingsNote, Mode=OneWay}"
                        IsOpen="{x:Bind ViewModel.HasSettingsNote, Mode=OneWay}"
                        IsClosable="False">
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                            <Button AutomationProperties.AutomationId="UseConfigAnywayButton" Content="These are the settings I played with" Command="{x:Bind ViewModel.UseLiveConfigCommand, Mode=OneTime}" />
                            <Button AutomationProperties.AutomationId="EnterSettingsButton" Content="Enter the settings used..." Click="GameSettings_Click" />
                        </StackPanel>
                    </InfoBar>

                    <!-- Settings the capture cannot show -->
                    <Expander
                        Header="{x:Bind ViewModel.SettingsHeader, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSettings, Mode=OneWay}"
                        IsExpanded="True"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="8">
                            <TextBlock
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Read from the game's config file at its last save, or entered by you. It may differ from what was active during this capture. Values marked (raw id) are the game's own numbers, not preset names." />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.SettingRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SettingRow">
                                        <Grid ColumnSpacing="16" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Label, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneTime}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>

                    <Border
                        Padding="20,16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Help analyxell know more" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Some things a capture cannot show: the game's graphics settings, whether G-SYNC or FreeSync is on, driver options, and where the game is installed. Add what you know to make the findings more accurate. It is all optional and stays on this PC." />
                            <TextBlock
                                Visibility="{x:Bind ViewModel.HasNoReader, Mode=OneWay}"
                                TextWrapping="Wrap"
                                FontWeight="SemiBold"
                                Text="analyxell has no built-in reader for this game's settings. Type them in, or let your own AI pull them out of the game's config file." />
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button AutomationProperties.AutomationId="GameSetupButton" Content="Set up this game..." Click="GameSetup_Click" />
                                <Button AutomationProperties.AutomationId="PcSetupButton" Content="Edit PC setup..." Click="Setup_Click" />
                            </StackPanel>
                            <Expander
                                Header="What analyxell knows about your setup"
                                Visibility="{x:Bind ViewModel.HasSystemRows, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SystemRows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SettingRow">
                                            <Grid ColumnSpacing="16" Padding="0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="300" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Label, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Value, Mode=OneTime}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Source, Mode=OneTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Programs competing with the game -->
                <Border
                    Visibility="{x:Bind ViewModel.IsBackgroundTab, Mode=OneWay}"
                    Padding="20,16"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Is something else slowing the game down?" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="A capture cannot show which other programs were running. This check looks at your PC right now for 10 seconds: which programs use CPU, disk and GPU, and which well-known troublemakers (overlays, recorders, browsers, updaters) are open. For the best result, start the game, play or idle in a menu, then switch back here and run it. It only reads; it never closes or changes anything." />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button
                                AutomationProperties.AutomationId="CheckBackgroundButton"
                                Content="Check background programs (10 s)"
                                Command="{x:Bind ViewModel.CheckBackgroundCommand, Mode=OneTime}"
                                IsEnabled="{x:Bind ViewModel.NotScanning, Mode=OneWay}" />
                            <ProgressRing Width="22" Height="22" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                            <TextBlock Text="{x:Bind ViewModel.ScanStatus, Mode=OneWay}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            AutomationProperties.AutomationId="BackgroundSummary"
                            Text="{x:Bind ViewModel.BackgroundSummary, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.HasBackgroundSummary, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <StackPanel Spacing="2" Visibility="{x:Bind ViewModel.HasBackground, Mode=OneWay}">
                            <Grid ColumnSpacing="12" Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="1.4*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Program" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="2" Text="Disk" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="3" Text="GPU" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="Memory" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Grid.Column="5" Text="Known as" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.BackgroundRows, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BackgroundRow">
                                        <Grid ColumnSpacing="12" Padding="0,4" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.4*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Cpu, Mode=OneTime}" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Disk, Mode=OneTime}" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind Gpu, Mode=OneTime}" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind Memory, Mode=OneTime}" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind Note, Mode=OneTime}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <TextBlock
                Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
