<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Analyxell.Controls.FrameTimeChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root" SizeChanged="Root_SizeChanged">
        <Canvas
            x:Name="Plot"
            Background="Transparent"
            PointerMoved="Plot_PointerMoved"
            PointerExited="Plot_PointerExited" />
        <Border
            x:Name="Tip"
            Visibility="Collapsed"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Padding="8,4"
            CornerRadius="4"
            IsHitTestVisible="False"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1">
            <TextBlock x:Name="TipText" Style="{StaticResource CaptionTextBlockStyle}" />
        </Border>
    </Grid>
</UserControl>
