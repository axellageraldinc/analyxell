<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Daignostic.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer>
        <StackPanel Padding="32,8,32,32" Spacing="20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                IsClosable="True" />

            <StackPanel Spacing="12">
                <TextBlock Text="Captures" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="Captures folder"
                        PlaceholderText="Where CapFrameX saves captures"
                        Text="{x:Bind ViewModel.CapturesFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Command="{x:Bind ViewModel.BrowseCommand, Mode=OneTime}" />
                </Grid>
                <ToggleSwitch
                    Header="Find captures through CapFrameX (MCP)"
                    OnContent="On"
                    OffContent="Off"
                    IsOn="{x:Bind ViewModel.UseMcp, Mode=TwoWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox AutomationProperties.AutomationId="McpUrlBox" Header="CapFrameX MCP address" Text="{x:Bind ViewModel.McpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button AutomationProperties.AutomationId="TestMcpButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Test connection" Command="{x:Bind ViewModel.TestMcpCommand, Mode=OneTime}" />
                </Grid>
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="CapFrameX must be running with MCP enabled. daignostic only calls tools that read data; it never starts captures or changes CapFrameX settings." />
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="AI analysis" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Any OpenAI-compatible endpoint works, for example a self-hosted xellter gateway. The preset is the model or preset name the endpoint should use." />
                <TextBox AutomationProperties.AutomationId="EndpointBox" Header="Endpoint" Text="{x:Bind ViewModel.AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBox AutomationProperties.AutomationId="PresetBox" Header="Preset / model name" Text="{x:Bind ViewModel.AiPreset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <PasswordBox
                    x:Name="KeyBox"
                    AutomationProperties.AutomationId="ApiKeyBox"
                    Header="API key"
                    PlaceholderText="Leave empty to keep the saved key"
                    PasswordChanged="KeyBox_PasswordChanged" />
                <TextBlock
                    Text="{x:Bind ViewModel.KeyStatus, Mode=OneWay}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="TestAiButton" Content="Test AI connection" Command="{x:Bind ViewModel.TestAiCommand, Mode=OneTime}" />
                    <Button AutomationProperties.AutomationId="ClearKeyButton" Content="Delete saved key" Command="{x:Bind ViewModel.ClearKeyCommand, Mode=OneTime}" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsTesting, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <Button AutomationProperties.AutomationId="SaveSettingsButton" Content="Save settings" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand, Mode=OneTime}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Read-only by design" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="daignostic only reads capture files and game config files. It never edits game settings, starts captures or runs commands. The AI receives text only and has no tools. The only things it writes are its own settings (when you press Save) and a report file at a location you choose." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
