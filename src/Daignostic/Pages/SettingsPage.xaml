<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Daignostic.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Disabled">

    <ScrollViewer>
        <StackPanel Padding="32,8,32,32" Spacing="24" MaxWidth="860" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />

            <InfoBar
                Severity="{x:Bind ViewModel.MessageSeverity, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                IsClosable="True" />

            <!-- Captures and CapFrameX -->
            <StackPanel Spacing="12">
                <TextBlock Text="Captures" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Header="Captures folder"
                        PlaceholderText="Where CapFrameX saves captures"
                        Text="{x:Bind ViewModel.CapturesFolder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" VerticalAlignment="Bottom" Content="Browse..." Command="{x:Bind ViewModel.BrowseCommand, Mode=OneTime}" />
                </Grid>

                <ToggleSwitch
                    Header="Find captures through CapFrameX (optional)"
                    OnContent="On"
                    OffContent="Off"
                    IsOn="{x:Bind ViewModel.UseMcp, Mode=TwoWay}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox AutomationProperties.AutomationId="McpUrlBox" Header="CapFrameX MCP address" Text="{x:Bind ViewModel.McpUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button AutomationProperties.AutomationId="TestMcpButton" Grid.Column="1" VerticalAlignment="Bottom" Content="Test connection" Command="{x:Bind ViewModel.TestMcpCommand, Mode=OneTime}" />
                </Grid>
                <InfoBar
                    Severity="{x:Bind ViewModel.McpSeverity, Mode=OneWay}"
                    Message="{x:Bind ViewModel.McpStatus, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.HasMcpStatus, Mode=OneWay}"
                    IsClosable="False" />

                <Expander Header="How to turn on CapFrameX's MCP server (step by step)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="McpTutorial">
                    <StackPanel Spacing="10">
                        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="This is optional. daignostic can always open a capture file directly. MCP only lets it list your captures for you, and it only ever reads." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="1. Use CapFrameX 1.9.1 or newer." />
                        <TextBlock TextWrapping="Wrap" Margin="16,-6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Check the version in CapFrameX (title bar or About). Older versions have no MCP server." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="2. Close CapFrameX completely." />
                        <TextBlock TextWrapping="Wrap" Margin="16,-6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Right-click its icon near the clock and choose Exit. If you leave it running, it can overwrite the change you are about to make." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="3. Turn the setting on." />
                        <TextBlock TextWrapping="Wrap" Margin="16,-6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Open CapFrameX's Configuration folder (the button below does it), open AppSettings.json in Notepad, find the line &quot;McpEnabled&quot;, change false to true, and save. The installed version keeps it in %APPDATA%\CapFrameX\Configuration. The portable version keeps it in a Configuration folder next to CapFrameX.exe." />
                        <Button AutomationProperties.AutomationId="OpenCapFrameXFolderButton" Content="Open CapFrameX settings folder" Command="{x:Bind ViewModel.OpenCapFrameXFolderCommand, Mode=OneTime}" Margin="16,0,0,0" />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="4. Start CapFrameX again." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="5. Press Test connection above." />
                        <TextBlock TextWrapping="Wrap" Margin="16,-6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="The usual address is http://localhost:1337/mcp. If CapFrameX picked another port because 1337 was busy, the line &quot;WebservicePort&quot; in the same file shows it." />
                        <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="If it still does not connect" />
                        <TextBlock TextWrapping="Wrap" Margin="16,-6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Test connection tells you which case you are in. &quot;Nothing answered&quot; means CapFrameX is not running or the port is different. &quot;Not an MCP server&quot; means CapFrameX is running but McpEnabled is still false, or it is too old." />
                    </StackPanel>
                </Expander>
            </StackPanel>

            <!-- AI -->
            <StackPanel Spacing="12">
                <TextBlock Text="AI (optional)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Everything else works without AI. If you prefer not to connect one, leave this off: on the Analyze page you can export the same information to a file and give it to any AI yourself." />
                <ToggleSwitch
                    AutomationProperties.AutomationId="AiEnabledSwitch"
                    Header="Ask an AI from inside daignostic"
                    OnContent="On"
                    OffContent="Off"
                    IsOn="{x:Bind ViewModel.AiEnabled, Mode=TwoWay}" />

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.AiEnabled, Mode=OneWay}">
                    <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Any OpenAI-compatible endpoint works: a hosted service, or a gateway or model on your own PC (the best choice for privacy)." />
                    <TextBox
                        AutomationProperties.AutomationId="EndpointBox"
                        Header="Endpoint address"
                        PlaceholderText="For example http://127.0.0.1:8480 or https://api.example.com"
                        Text="{x:Bind ViewModel.AiEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            AutomationProperties.AutomationId="ModelBox"
                            Header="Model name"
                            PlaceholderText="For example gpt-5, claude-sonnet-5-5 or llama3.1:8b"
                            Text="{x:Bind ViewModel.AiModel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button AutomationProperties.AutomationId="ListModelsButton" Grid.Column="1" VerticalAlignment="Bottom" Content="List models" Command="{x:Bind ViewModel.ListModelsCommand, Mode=OneTime}" />
                    </Grid>
                    <ComboBox
                        x:Name="ModelPick"
                        AutomationProperties.AutomationId="ModelPick"
                        Header="Models your endpoint offers (pick one to fill in the name)"
                        HorizontalAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.HasModels, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.Models, Mode=OneTime}"
                        SelectionChanged="ModelPick_SelectionChanged" />
                    <TextBlock TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="Type the name exactly as your provider spells it, including dashes, dots and capitals: it is sent unchanged, so claude-sonnet-5-5 and Claude Sonnet 5.5 are different names to a server. List models asks your endpoint what it offers (not every provider supports that)." />

                    <PasswordBox
                        x:Name="KeyBox"
                        AutomationProperties.AutomationId="ApiKeyBox"
                        Header="API key"
                        PlaceholderText="Leave empty to keep the saved key"
                        PasswordChanged="KeyBox_PasswordChanged" />
                    <ToggleSwitch
                        AutomationProperties.AutomationId="SaveKeySwitch"
                        Header="Remember the key on this PC"
                        OnContent="Yes, saved encrypted"
                        OffContent="No, memory only until daignostic closes"
                        IsOn="{x:Bind ViewModel.SaveApiKey, Mode=TwoWay}" />
                    <TextBlock Text="{x:Bind ViewModel.KeyStatus, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                    <Border
                        AutomationProperties.AutomationId="KeyAssurance"
                        Padding="20,16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Your key stays on this PC. Here is exactly how" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Text="&#x2022; Never stored as readable text. It is encrypted with Windows' own data protection (DPAPI) for your Windows account." />
                            <TextBlock TextWrapping="Wrap" Text="&#x2022; Never in the settings file, logs, reports, exported files or anything shared with an AI. The AI is sent measurements only." />
                            <TextBlock TextWrapping="Wrap" Text="&#x2022; Sent to one place only: the endpoint address above, in the standard Authorization header. daignostic has no server of its own, no accounts and no telemetry." />
                            <TextBlock TextWrapping="Wrap" Text="&#x2022; You can check it: the button below shows the stored file, which is unreadable encrypted data. You can delete it at any time, or choose memory-only above so nothing is written to disk." />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="An honest limit: Windows encryption protects the key from other Windows users and from anyone who copies your disk. A program already running as you could still ask Windows to decrypt it, as with any app's saved password. Prefer a key with a spending limit, or a local gateway." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button AutomationProperties.AutomationId="ShowStoredKeyButton" Content="Show what is stored" Command="{x:Bind ViewModel.ShowStoredKeyCommand, Mode=OneTime}" />
                                <Button AutomationProperties.AutomationId="ClearKeyButton" Content="Delete the saved key" Command="{x:Bind ViewModel.ClearKeyCommand, Mode=OneTime}" />
                            </StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.KeyStoredInfo, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.HasKeyInfo, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True"
                                FontFamily="Consolas"
                                FontSize="12" />
                        </StackPanel>
                    </Border>

                    <ToggleSwitch
                        AutomationProperties.AutomationId="ShareNamesSwitch"
                        Header="Include the names of other running programs in AI messages"
                        OnContent="Yes"
                        OffContent="No, send only anonymous categories (recommended)"
                        IsOn="{x:Bind ViewModel.ShareBackgroundNames, Mode=TwoWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button AutomationProperties.AutomationId="TestAiButton" Content="Test AI connection" Command="{x:Bind ViewModel.TestAiCommand, Mode=OneTime}" />
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsTesting, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsTesting, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Button AutomationProperties.AutomationId="SaveSettingsButton" Content="Save settings" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand, Mode=OneTime}" />

            <StackPanel Spacing="8">
                <TextBlock Text="Read-only by design" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="daignostic reads capture files, game config files you point it to, and a few Windows settings. It never edits game settings, starts captures, closes programs or runs commands. An AI receives text only and has no tools, so it cannot look at or change anything on your PC. The only things daignostic writes are its own settings, the setup and game settings you enter, and reports or export files at a location you choose." />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
