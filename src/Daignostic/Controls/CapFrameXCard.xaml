<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Daignostic.Controls.CapFrameXCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="20,16"
        CornerRadius="8"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1">
        <StackPanel Spacing="10">
            <TextBlock Text="CapFrameX" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind ViewModel.Headline, Mode=OneWay}"
                Style="{StaticResource SubtitleTextBlockStyle}"
                TextWrapping="Wrap"
                AutomationProperties.AutomationId="CapFrameXHeadline" />
            <TextBlock
                Text="{x:Bind ViewModel.Detail, Mode=OneWay}"
                TextWrapping="Wrap"
                IsTextSelectionEnabled="True"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    AutomationProperties.AutomationId="CapFrameXOpenButton"
                    Content="Open CapFrameX"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.Found, Mode=OneWay}"
                    Command="{x:Bind ViewModel.OpenCommand, Mode=OneTime}" />
                <Button
                    AutomationProperties.AutomationId="CapFrameXGetButton"
                    Content="Get CapFrameX (GitHub)"
                    Style="{StaticResource AccentButtonStyle}"
                    Visibility="{x:Bind ViewModel.NotFound, Mode=OneWay}"
                    Command="{x:Bind ViewModel.GetCommand, Mode=OneTime}" />
                <Button
                    AutomationProperties.AutomationId="CapFrameXChooseButton"
                    Content="Choose CapFrameX.exe..."
                    Command="{x:Bind ViewModel.ChooseCommand, Mode=OneTime}" />
                <Button
                    AutomationProperties.AutomationId="CapFrameXRefreshButton"
                    Content="Check again"
                    Click="Refresh_Click" />
            </StackPanel>
            <InfoBar
                Severity="{x:Bind ViewModel.Message.Severity, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message.Text, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.Message.IsOpen, Mode=OneWay}"
                IsClosable="False" />
        </StackPanel>
    </Border>
</UserControl>
