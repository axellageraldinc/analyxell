<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Daignostic.Controls.AiPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Daignostic.ViewModels">

    <StackPanel Spacing="12">
        <TextBlock Text="Ask an AI to explain these results" Style="{StaticResource SubtitleTextBlockStyle}" />

        <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
            <Run Text="Only the measured facts previewed below are sent to" />
            <Run Text="{x:Bind ViewModel.Destination, Mode=OneWay}" FontWeight="SemiBold" />
            <Run Text=". File paths and device names are never included, and nothing is sent until you press Ask AI. The AI has no tools: it cannot read or change anything on this PC." />
        </TextBlock>

        <Expander Header="Preview exactly what will be sent" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <TextBox
                x:Name="PreviewBox"
                Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                IsReadOnly="True"
                AcceptsReturn="True"
                TextWrapping="NoWrap"
                FontFamily="Consolas"
                FontSize="12"
                MaxHeight="280"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                AutomationProperties.Name="Data that will be sent to the AI" />
        </Expander>

        <TextBox
            AutomationProperties.AutomationId="AiNoteBox"
            Header="Note for the AI (optional)"
            PlaceholderText="For example: I turned ray tracing off between these runs"
            Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLength="600" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.AutomationId="AskAiButton"
                Content="Ask AI"
                Style="{StaticResource AccentButtonStyle}"
                Command="{x:Bind ViewModel.AskCommand, Mode=OneTime}" />
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <InfoBar
            Severity="Warning"
            Title="The AI request failed"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            IsClosable="False" />

        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}">
            <TextBlock
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <InfoBar
                Severity="Informational"
                Title="The AI could not reach a firm conclusion from this data."
                IsOpen="{x:Bind ViewModel.IsInconclusive, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                Severity="Informational"
                Message="{x:Bind ViewModel.DroppedNotice, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasDropped, Mode=OneWay}"
                IsClosable="False" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiItemView">
                        <Border
                            Margin="0,0,0,8"
                            Padding="16,12"
                            CornerRadius="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock
                                        Text="{x:Bind Confidence, Mode=OneTime}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="{x:Bind Explanation, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{x:Bind Actions, Mode=OneTime}"
                                    Visibility="{x:Bind HasActions, Mode=OneTime}"
                                    TextWrapping="Wrap"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind Evidence, Mode=OneTime}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
