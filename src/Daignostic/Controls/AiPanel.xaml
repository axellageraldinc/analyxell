<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Daignostic.Controls.AiPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Daignostic.ViewModels">

    <StackPanel Spacing="14">

        <TextBlock
            TextWrapping="Wrap"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="daignostic measured everything shown on the other tabs. An AI can explain it for your PC, rank the likely causes and put the fixes in order. It sees the measurements only, never your files or your computer's name, and it answers once: it cannot ask you questions or look at your PC." />

        <!-- Not set up -->
        <InfoBar
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="AI is optional."
            Message="Connect one to ask from inside daignostic, or save everything to a file and ask your own AI (a chat website, an app, a local model)."
            Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay}" />

        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button
                AutomationProperties.AutomationId="AskAiButton"
                Content="Ask AI"
                Style="{StaticResource AccentButtonStyle}"
                Padding="24,8"
                Visibility="{x:Bind ViewModel.IsConfigured, Mode=OneWay}"
                IsEnabled="{x:Bind ViewModel.NotBusy, Mode=OneWay}"
                Command="{x:Bind ViewModel.AskCommand, Mode=OneTime}" />
            <Button
                AutomationProperties.AutomationId="SetupAiButton"
                Content="Set up AI in daignostic"
                Style="{StaticResource AccentButtonStyle}"
                Padding="24,8"
                Visibility="{x:Bind ViewModel.NeedsSetup, Mode=OneWay}"
                Command="{x:Bind ViewModel.SetupAiCommand, Mode=OneTime}" />
            <Button
                AutomationProperties.AutomationId="ExportPackButton"
                Content="Export for my own AI..."
                Padding="16,8"
                Command="{x:Bind ViewModel.ExportPackCommand, Mode=OneTime}" />
        </StackPanel>

        <TextBlock
            Text="{x:Bind ViewModel.ExportStatus, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.HasExportStatus, Mode=OneWay}"
            TextWrapping="Wrap"
            Style="{StaticResource CaptionTextBlockStyle}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

        <!-- Working -->
        <Border
            AutomationProperties.AutomationId="AiProgress"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
            Padding="20,16"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
            BorderThickness="1">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Width="36" Height="36" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.PhaseText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.ElapsedText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        AutomationProperties.AutomationId="CancelAiButton"
                        Content="Cancel"
                        VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.CancelCommand, Mode=OneTime}" />
                </Grid>
                <ProgressBar IsIndeterminate="True" />
                <TextBlock
                    Text="{x:Bind ViewModel.HintText, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasHint, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Failed or cancelled -->
        <Border
            AutomationProperties.AutomationId="AiError"
            Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Padding="20,16"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
            BorderThickness="1">
            <StackPanel Spacing="8">
                <TextBlock Text="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.ErrorAdvice, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="AiTryAgainButton" Content="Try again" Command="{x:Bind ViewModel.AskCommand, Mode=OneTime}" />
                    <Button
                        AutomationProperties.AutomationId="AiOpenSettingsButton"
                        Content="Open AI settings"
                        Visibility="{x:Bind ViewModel.ErrorNeedsSettings, Mode=OneWay}"
                        Command="{x:Bind ViewModel.SetupAiCommand, Mode=OneTime}" />
                </StackPanel>
                <Expander Header="What the AI said" Visibility="{x:Bind ViewModel.HasErrorRaw, Mode=OneWay}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBox Text="{x:Bind ViewModel.ErrorRaw, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" MaxHeight="220" />
                </Expander>
            </StackPanel>
        </Border>

        <Expander Header="Preview exactly what will be sent or exported" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="8">
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Destination:" />
                    <Run Text="{x:Bind ViewModel.Destination, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text=". Nothing is sent until you press Ask AI. The AI has no tools: it cannot read or change anything on this PC." />
                </TextBlock>
                <TextBox
                    x:Name="PreviewBox"
                    Text="{x:Bind ViewModel.Preview, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    FontSize="12"
                    MaxHeight="280"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    AutomationProperties.Name="Data that will be sent to the AI" />
            </StackPanel>
        </Expander>

        <TextBox
            AutomationProperties.AutomationId="AiNoteBox"
            Header="Anything the AI should know? (optional)"
            PlaceholderText="For example: I turned ray tracing off between these runs"
            Text="{x:Bind ViewModel.Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            MaxLength="600" />

        <!-- The answer -->
        <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay}" AutomationProperties.AutomationId="AiResult">
            <TextBlock Text="The AI's answer" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                Visibility="{x:Bind ViewModel.HasSummary, Mode=OneWay}"
                TextWrapping="Wrap"
                Style="{StaticResource BodyStrongTextBlockStyle}" />

            <InfoBar
                Severity="Informational"
                Title="The AI could not reach a firm conclusion from this data."
                IsOpen="{x:Bind ViewModel.IsInconclusive, Mode=OneWay}"
                IsClosable="False" />

            <InfoBar
                Severity="Informational"
                Message="{x:Bind ViewModel.DroppedNotice, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.HasDropped, Mode=OneWay}"
                IsClosable="False" />

            <ItemsControl ItemsSource="{x:Bind ViewModel.Items, Mode=OneTime}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiItemView">
                        <Expander
                            Margin="0,0,0,6"
                            IsExpanded="{x:Bind IsFirst, Mode=OneTime}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,6">
                                    <TextBlock Text="{x:Bind Title, Mode=OneTime}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{x:Bind Confidence, Mode=OneTime}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="6">
                                <TextBlock Text="{x:Bind Explanation, Mode=OneTime}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <TextBlock
                                    Text="{x:Bind Actions, Mode=OneTime}"
                                    Visibility="{x:Bind HasActions, Mode=OneTime}"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                <TextBlock
                                    Text="{x:Bind Evidence, Mode=OneTime}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasUnknowns, Mode=OneWay}">
                <TextBlock Text="What the AI could not tell from this data" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.UnknownsText, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
